# TRUST//INTERCEPT — frontend build-time configuration
# This is safe to expose in a Vite build because it contains only the public backend URL.
# NEVER put GONKA_API_KEY, FEATHERLESS_API_KEY, GEMINI_API_KEY or other secrets here.

# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Vercel production example (replace with your deployed FastAPI backend):
# VITE_API_BASE_URL=https://YOUR-BACKEND-DOMAIN.example.com
