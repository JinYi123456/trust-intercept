# TRUST//INTERCEPT — backend/deployment configuration template
# Copy to `.env` for local development. NEVER commit `.env` or real keys.
# For Vercel, do NOT put backend provider keys in Vercel frontend environment variables.
# Put VITE_API_BASE_URL in the Vercel frontend project, and provider secrets in the
# environment of the deployed FastAPI backend.

# ----------------------------- Backend -----------------------------
# LIVE DEMO: use one hosted provider. Recommended competition path:
LLM_PROVIDER=gonka

# Hosted LLM providers. Leave unused keys blank.
GONKA_API_KEY=
GONKA_MODEL=MiniMaxAI/MiniMax-M2.7
GONKA_BASE_URL=https://api.gonkarouter.io/v1/messages

FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1/chat/completions

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# ---------------------- Reputation / multimodal ----------------------
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=
GOOGLE_VISION_API_KEY=
OCR_CLOUD_FALLBACK=false

# ----------------------------- Safety -----------------------------
# LIVE DEMO: true enables URL/reputation inspection tools when their keys/network are available.
# Set false for a fully offline local fallback.
ALLOW_OUTBOUND_LOOKUPS=true
REDIRECT_MAX_HOPS=5
OUTBOUND_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1400

# ----------------------------- Storage -----------------------------
# For local development. Production should use persistent storage if SQLite is retained.
DB_PATH=backend/trust-intercept.db

# ----------------------------- CORS -----------------------------
# For local dev, keep the localhost entries. For deployment, replace/add your Vercel URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
