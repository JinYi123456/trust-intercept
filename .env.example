# TRUST//INTERCEPT — safe configuration template
# Copy to .env locally. NEVER commit .env or real API keys.

# ----------------------------- LLM -----------------------------
# Free-first policy: Gemini only. Leave empty for deterministic offline mode.
LLM_PROVIDER=gemini                # gemini | none
gemini_api_key=
gemini_model=gemini-2.5-flash

# ---------------------- Optional reputation --------------------
# Keep empty for the competition's free/offline baseline.
virustotal_api_key=
safe_browsing_api_key=

# ----------------------------- Safety --------------------------
# false = no external URL/reputation calls; deterministic/local demo.
allow_outbound_lookups=false
ocr_cloud_fallback=false

# ----------------------------- App -----------------------------
redirect_max_hops=5
outbound_timeout_seconds=10
llm_timeout_seconds=45
llm_max_tokens=1400
